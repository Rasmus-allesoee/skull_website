{
  "name": "skull-collection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A visual-first online natural-history museum for animal skulls.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "pnpm content:build && next dev --webpack",
    "dev:network": "pnpm content:build && next dev --webpack --hostname 0.0.0.0",
    "preview:network": "pnpm build && next start --hostname 0.0.0.0",
    "build": "pnpm content:build && next build --webpack",
    "start": "next start",
    "content:build": "node --import tsx scripts/build-content.ts",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "validate:media": "node --import tsx scripts/validate-media.ts",
    "media:stage:phase2": "node --import tsx scripts/stage-media.ts scripts/phase-2-media-source-map.json",
    "media:stage:phase3.1": "node --import tsx scripts/stage-media.ts scripts/phase-3-1-review-media-source-map.json",
    "media:process": "node --import tsx scripts/process-media.ts",
    "media:process:reference": "node --import tsx scripts/process-reference-media.ts",
    "taxonomy:refresh": "node --import tsx scripts/refresh-taxonomy.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm content:build && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm content:build && vitest run",
    "test:fixtures": "node --import tsx scripts/verify-invalid-fixtures.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm validate:media && pnpm validate:content && pnpm typecheck && pnpm test && pnpm test:fixtures"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@orama/orama": "3.1.18",
    "csv-parse": "7.0.2",
    "gray-matter": "4.0.3",
    "maplibre-gl": "5.7.3",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
